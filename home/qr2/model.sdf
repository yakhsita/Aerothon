<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="qr2">

    <static>true</static>

    <link name="link">

      <visual name="visual">

        <geometry>
          <box>
            <size>1 0.01 1</size>
          </box>
        </geometry>

        <material>
          <diffuse>1 1 1 1</diffuse>
          <ambient>1 1 1 1</ambient>

          <pbr>
            <metal>
              <albedo_map>
                model://qr2/materials/textures/qr2.png
              </albedo_map>
            </metal>
          </pbr>
        </material>

      </visual>

      <collision name="collision">

        <geometry>
          <box>
            <size>1 0.01 1</size>
          </box>
        </geometry>

      </collision>

    </link>

  </model>
</sdf>
